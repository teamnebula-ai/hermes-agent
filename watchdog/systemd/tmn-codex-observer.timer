[Unit]
Description=Independent TMN Hermes watchdog, 4x daily

[Timer]
# TMN runs its credential check at 00/06/12/18:35. This independent observer checks
# shortly afterward and detects a missed heartbeat within about 7 hours.
OnCalendar=*-*-* 01,07,13,19:35:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
