[Unit]
Description=Backstop watch, 4x daily, offset from both Hermes hosts

[Timer]
# TMN runs 00/06/12/18:35, hostinger 03/09/15/21:35. This sits between them so a
# fleet-wide outage is noticed within ~90 minutes rather than at the next cycle.
OnCalendar=*-*-* 01,07,13,19:35:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
